  @optional_by_value<type=NewOrderBit7, presence_value=numBitFields, expr: >=7> bit7
  @optional_by_value<type=NewOrderBit8, presence_value=numBitFields, expr: >=8> bit8
  @optional_by_value<type=NewOrderBit9, presence_value=numBitFields, expr: >=9> bit9
  @optional_by_bit<type=ClearingFirm, presence_value=bit1, enum=NewOrderBit1, mask=ClearingFirm> clearingFirm
  @optional_by_bit<type=ClearingAccount, presence_value=bit1, enum=NewOrderBit1, mask=ClearingAccount> clearingAccount
  @optional_by_bit<type=Price4, presence_value=bit1, enum=NewOrderBit1, mask=Price> price
  @optional_by_bit<type=ExecInst, presence_value=bit1, enum=NewOrderBit1, mask=ExecInst> execInst
  @optional_by_bit<type=OrdType, presence_value=bit1, enum=NewOrderBit1, mask=OrdType> ordType
  @optional_by_bit<type=TimeInForce, presence_value=bit1, enum=NewOrderBit1, mask=TimeInForce> tif
  @optional_by_bit<type=MinQty, presence_value=bit1, enum=NewOrderBit1, mask=MinQty> minQty
  @optional_by_bit<type=MaxFloor, presence_value=bit1, enum=NewOrderBit1, mask=MaxFloor> maxFloor
  @optional_by_bit<type=Symbol, presence_value=bit2, enum=NewOrderBit2, mask=Symbol> symbol
  @optional_by_bit<type=SymbolSfx, presence_value=bit2, enum=NewOrderBit2, mask=SymbolSfx> symbolSfx
  @optional_by_bit<type=Currency, presence_value=bit2, enum=NewOrderBit2, mask=Currency> currency
  @optional_by_bit<type=IDSource, presence_value=bit2, enum=NewOrderBit2, mask=IDSource> idSource
  @optional_by_bit<type=SecurityID, presence_value=bit2, enum=NewOrderBit2, mask=SecurityID> securityID
  @optional_by_bit<type=SecurityExchange, presence_value=bit2, enum=NewOrderBit2, mask=SecurityExchange> securityExchange
  @optional_by_bit<type=Capacity, presence_value=bit2, enum=NewOrderBit2, mask=Capacity> capacity
  @optional_by_bit<type=RoutingInst, presence_value=bit2, enum=NewOrderBit2, mask=RoutingInst> routingInst
