message OrderAckV2 : Header {
  u64 transactionTime
  str20 clOrdID
  u8 reserved
  OrderRespOptGrp optGrp
} [ size = , link_base: msgType = OrderAcknowledgementV2 ]

enum ReasonCode : char_ebt {
  Admin = 'A'
  DuplicateIdentifier = 'D'
  Halted = 'H'
  IncorrectDataCenter = 'I'
  TooLateToCancel = 'J'
  OrderRateThresholdExceeded = 'K'
  PriceExceedsCrossRange = 'L'
  LiquidityAvailableExceedsOrderSize = 'M'
  RanOutOfLiquidityToExecuteAgainst = 'N'
  ClOrdIDDoesntMatchaKnownOrder = 'O'
  CantModifyAnOrderThatIsPendingFill = 'P'
  WaitingForFirstTrade = 'Q'
  UserRequested = 'U'
  WouldWash = 'Y'
  AddLiquidityOnlyOrderWouldRemove = 'W'
  OrderExpired = 'X'
  SymbolNotSupported = 'Y'
  UnforeseenReason = 'Z'
  CancelledOnHitSmallRemainder = 'j'
  MarketAccessRiskLimitExceeded = 'm'
  MaxOpenOrdersCountExceeded = 'o'
  RiskManagementSymbolLevel = 's'
  CrossedMarket = 'x'
  OrderReceivedByCboeDuringReplay = 'y'
  RegQuoteDifferentToRoomQuote = '1'
}

message OrderRejectedV2 : Header {
  u64 transTime
  str20 clOrdID
  ReasonCode code
  str60 text
  u8 reserved
  OrderRespOptGrp optGrp
} [ size = , link_base: msgType = OrderRejectedV2 ]

message OrderCancelledV2 : Header {
  u64 transTime
  str20 clOrdID
  ReasonCode code
  str60 text
  u8 reserved
  OrderRespOptGrp optGrp
} [ size = , link_base: msgType = OrderCancelledV2 ]

message OrderModifiedV2 : Header {
  u64 transTime
  str20 clOrdID
  u64 orderID
  u8 reserved
  OrderRespOptGrp optGrp
} [ size = , link_base: msgType = OrderModifiedV2 ]

enum LiqIndicator : char_ebt {
  Added = 'A'
  Removed = 'R'
  Routed = 'X'
  Auction = 'C'
}

message OrderExecutionV2 : Header {
  u64 transTime
  str20 clOrdID
  u64 execID
  u32 lastShares
  Price4 lastPx
  u32 leavesQty
  LiqIndicator liqInd
  SubLiquidityIndicator subLiqInd
  str4 contraBroker
  u8 reserved
  OrderRespOptGrp optGrp
} [ size = , link_base: msgType = OrderExecutionV2 ]
























































