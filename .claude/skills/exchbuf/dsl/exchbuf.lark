// exchbuf DSL - Lark grammar
//
// Language for describing exchange binary wire protocols.
// Parser target: LALR(1) with contextual lexer (Lark default).
//
// Usage:
//   from lark import Lark
//   with open("exchbuf.lark") as f:
//       parser = Lark(f, parser="lalr")
//   tree = parser.parse(open("my_protocol.eb").read())

start: statement*

// Top-level statements
statement: cpp_directive
         | python_directive
         | include_directive
         | comment_directive
         | primitive_decl
         | alias_decl
         | array_decl
         | enum_decl
         | bitfield_decl
         | message_decl

// ============================================================
// Directives
// ============================================================
// @cpp / @python capture the rest-of-line as an opaque code fragment.
// @include is also captured whole so inline comments are consumed.

cpp_directive:     CPP_LINE
python_directive:  PYTHON_LINE
include_directive: INCLUDE_LINE
comment_directive: SLASH_COMMENT

// ============================================================
// Primitive type declaration
// ============================================================
// primitive <alias> = <int_type> [ <props> ]
// primitive <alias> = FixedLengthString [ <props> ]
// primitive <alias> = FloatDecimal [ <props> ]

primitive_decl: "primitive" NAME "=" int_type "[" int_props "]"
              | "primitive" NAME "=" "FixedLengthString" "[" fls_props "]"
              | "primitive" NAME "=" "FloatDecimal" "[" fd_props "]"

int_props: int_prop ("," int_prop)*

int_prop: "min" "=" opt_number
        | "max" "=" opt_number
        | "null" "=" opt_number
        | "little_endian" "=" bool_val

fls_props: fls_prop ("," fls_prop)*

fls_prop: "length" "=" INT
        | "padding" "=" CHAR_LITERAL
        | "right_padded" "=" bool_val
        | "left_padding" "=" bool_val

fd_props: fd_prop ("," fd_prop)*

fd_prop: "min" "=" opt_number
       | "max" "=" opt_number
       | "null" "=" opt_number
       | "size" "=" INT
       | "precision" "=" INT
       | "signed" "=" bool_val
       | "little_endian" "=" bool_val

// ============================================================
// Alias
// ============================================================
// alias <name> = <type>
// alias <name> = <type1> [ if <pred> else <type2> ]

alias_decl: "alias" NAME "=" NAME
          | "alias" NAME "=" NAME "[" "if" NAME "else" NAME "]"

// ============================================================
// Top-level fixed array declaration
// ============================================================
// array<type=<T>, size=<N>> <name>

array_decl: "array" "<" "type" "=" NAME "," "size" "=" INT ">" NAME

// ============================================================
// Enum
// ============================================================
// enum <name> : <int_type> { <member>+ }

enum_decl: "enum" NAME ":" int_type "{" enum_member+ "}"

enum_member: NAME "=" literal

// ============================================================
// Bitfield
// ============================================================
// bitfield <name> : <int_type> { <member>+ }

bitfield_decl: "bitfield" NAME ":" int_type "{" bitfield_member+ "}"

bitfield_member: "enum" "=" NAME "," "default" "=" NAME "," "length" "=" INT

// ============================================================
// Message
// ============================================================
// message <name> : [<parent>] { <member>* }

// Optional trailing properties on a message:
//   `} [ size = <opt_number>, link_base: <opt_field> = <opt_value> ]`
// Both halves of the link_base value (the field name and the enum-member
// name) may be empty; the leading `=` is always present.
message_decl: "message" NAME ":" NAME "{" message_member* "}" msg_props?
            | "message" NAME ":" "{" message_member* "}" msg_props?

msg_props: "[" "size" "=" opt_number "," "link_base" ":" link_base_value "]"

link_base_value: "="
               | NAME "=" NAME

message_member: fixed_member
              | inline_array_member
              | fixed_bits_member
              | var_array_member
              | var_str_member
              | optional_by_bit_member
              | optional_by_enum_member
              | optional_by_len_member
              | optional_by_value_member

// <type> <name>
// <type> <name> [ default = <value> ]
// The default value may be a numeric/char literal (e.g. 2, 0xBABA, 'B') or
// an enum member name (e.g. NewOrder).
fixed_member: NAME NAME ("[" "default" "=" default_value "]")?

default_value: literal | NAME

// @array<type=<T>, size=<N>> <name>
inline_array_member: "@array" "<" "type" "=" NAME "," "size" "=" INT ">" NAME

// @fixed_bits<type=<T>, nbits=<N>> <name>
fixed_bits_member: "@fixed_bits" "<" "type" "=" NAME "," "nbits" "=" INT ">" NAME

// @var_array<type=<T>, counter=<field>> <name>
var_array_member: "@var_array" "<" "type" "=" NAME "," "counter" "=" NAME ">" NAME

// @var_str<size=<field>, offset=<N>> <name>
// N may be negative (e.g. offset=-1) — use a small wrapper rule so the
// generator can extract the value while the grammar accepts both INT and NEG_INT.
var_str_member: "@var_str" "<" "size" "=" NAME "," "offset" "=" signed_int ">" NAME

signed_int: INT | NEG_INT

// @optional_by_bit<type=<T>, presence_value=<field>, enum=<E>, mask=<enum_val>> <name>
optional_by_bit_member: "@optional_by_bit" "<" "type" "=" NAME "," "presence_value" "=" NAME "," "enum" "=" NAME "," "mask" "=" NAME ">" NAME

// @optional_by_enum <name> with_presence_value <field> { type: <T>, enum_value: <V> ... }
optional_by_enum_member: "@optional_by_enum" NAME "with_presence_value" NAME "{" optional_by_enum_entry+ "}"

optional_by_enum_entry: "type" ":" NAME "," "enum_value" ":" NAME

// @optional_by_len<type=<T>, presence_length=<field>> <name>
optional_by_len_member: "@optional_by_len" "<" "type" "=" NAME "," "presence_length" "=" NAME ">" NAME

// @optional_by_value<type=<T>, presence_value=<field>, expr: <op><num>> <name>
optional_by_value_member: "@optional_by_value" "<" "type" "=" NAME "," "presence_value" "=" NAME "," "expr" ":" comparison_expr ">" NAME

comparison_expr: CMP_OP number

// ============================================================
// Primitive integer base types
// ============================================================
int_type: "char_ebt"
        | "int8_ebt"
        | "int16_ebt"
        | "int32_ebt"
        | "int64_ebt"
        | "uint8_ebt"
        | "uint16_ebt"
        | "uint32_ebt"
        | "uint64_ebt"

// ============================================================
// Value helpers
// ============================================================

// opt_number: a number that may be omitted (empty "=" with nothing after)
opt_number: number?

// All supported numeric literal forms (hex/bin before int for longest-match priority)
number: HEX_INT
      | BIN_INT
      | NEG_HEX_INT
      | NEG_BIN_INT
      | NEG_INT
      | INT

literal: number
       | CHAR_LITERAL

bool_val: "true" | "false"

// ============================================================
// Terminals
// ============================================================

// Identifier: starts with letter or underscore
NAME: /[a-zA-Z_][a-zA-Z0-9_]*/

// Integer literals — HEX_INT/BIN_INT at priority 2 to beat plain INT
// on the "0" prefix (longest match also guarantees this, but explicit
// priority makes the intent unambiguous).
HEX_INT.2:     /0[xX][0-9a-fA-F]+/
BIN_INT.2:     /0[bB][01]+/
INT:           /[0-9]+/
NEG_HEX_INT.2: /-0[xX][0-9a-fA-F]+/
NEG_BIN_INT.2: /-0[bB][01]+/
NEG_INT:       /-[0-9]+/

// Character literal: single character or escape sequence in single quotes.
// Supported escapes: \0 \n \r \t \\ \' \"
CHAR_LITERAL: /\'([^\'\\]|\\[0nrt\\\'"])\'/

// Comparison operator used in @optional_by_value expr clauses
CMP_OP: ">=" | "<=" | ">" | "<" | "==" | "!="

// Directive terminals consume the whole remaining line at priority 2 so that
// content such as "@cpp //cpp comment" or "@include foo// note" is not split
// by the comment-ignore rules below.
CPP_LINE.2:     /@cpp[^\n]*/
PYTHON_LINE.2:  /@python[^\n]*/
INCLUDE_LINE.2: /@include[^\n]*/

// A standalone "// ..." line in the .eb file is preserved (carried through to
// generated output). Comments inside @cpp/@python/@include lines are absorbed
// by the higher-priority directive terminals above.
SLASH_COMMENT: /\/\/[^\n]*/

// ============================================================
// Ignored whitespace and comments
// ============================================================
%ignore /[ \t\n\r\f]+/
%ignore /#[^\n]*/


