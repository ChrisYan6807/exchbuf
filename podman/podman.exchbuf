FROM ubuntu:24.04
ENV LANG=C.UTF-8

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    g++ gcc make cmake python3 python3-dev python3-pip python3-venv git less unzip vim pybind11-dev libboost1.83-dev libyaml-cpp-dev python3-openssl \
 && python3 -m venv /opt/python3

RUN /opt/python3/bin/pip3 install --upgrade pip
RUN /opt/python3/bin/pip3 install twisted cython requests pandas dash pybind11 schema colorama termcolor zstandard\
                reportlab psutil validators lxml marshmallow terminaltables boltons flask_restx tzlocal orjson paramiko\
                cheroot zmq IPython scapy matplotlib pythran plumbum memoization coverage dill rpyc lark pyopenssl service_identity

COPY --from=exchbuf_src . /exchbuf
RUN cd /exchbuf/dep && unzip testplan-main.zip && unzip pyfixmsg-master.zip && SP="$(/opt/python3/bin/python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')" &&\
    cp -aR pyfixmsg-master/pyfixmsg "$SP/" && cp -aR testplan-main/testplan "$SP/" && rm -rf pyfixmsg-master testplan-main\
    rm -rf binlog-main && unzip binlog-main.zip && cd binlog-main && mkdir build && cd build && cmake -DCMAKE_INSTALL_PREFIX=./install .. &&  cmake --build . && cmake --install .

RUN cd exchbuf && ./dsl/generate.py && cd /exchbuf/test/Router && ./build.sh

RUN apt-get clean

